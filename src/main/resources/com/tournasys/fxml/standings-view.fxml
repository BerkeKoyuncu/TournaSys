<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.tournasys.controller.StandingsController"
            stylesheets="@../css/app.css"
            styleClass="root-container">

    <top>
        <fx:include fx:id="navbar" source="navbar.fxml"/>
    </top>

    <center>
        <VBox spacing="20" styleClass="content-area">
            <padding>
                <Insets top="30" left="30" right="30" bottom="30"/>
            </padding>

            <Label text="Standings" styleClass="page-title"/>
            <Label text="View the current points table." styleClass="page-subtitle"/>

            <VBox spacing="12" styleClass="card">
                <Label text="Points Table" styleClass="page-title"/>

                <TableView fx:id="standingsTable" prefHeight="450">
                    <columns>
                        <TableColumn text="Pos" prefWidth="60"/>
                        <TableColumn text="Team" prefWidth="220"/>
                        <TableColumn text="P" prefWidth="60"/>
                        <TableColumn text="W" prefWidth="60"/>
                        <TableColumn text="D" prefWidth="60"/>
                        <TableColumn text="L" prefWidth="60"/>
                        <TableColumn text="Pts" prefWidth="80"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>

</BorderPane>