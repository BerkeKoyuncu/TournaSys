<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.tournasys.controller.MatchController"
            stylesheets="@../css/app.css"
            styleClass="root-container">

    <top>
        <fx:include fx:id="navbar" source="navbar.fxml"/>
    </top>

    <center>
        <VBox spacing="20" styleClass="content-area">
            <padding>
                <Insets top="30" left="30" right="30" bottom="30"/>
            </padding>

            <Label text="Match Management" styleClass="page-title"/>
            <Label text="Schedule matches and enter scores." styleClass="page-subtitle"/>

            <HBox spacing="20">

                <VBox spacing="10" styleClass="card" prefWidth="340">
                    <Label text="Create Match" styleClass="page-title"/>

                    <Label text="Home Team"/>
                    <ComboBox fx:id="homeTeamBox" styleClass="input-field" prefWidth="270"/>

                    <Label text="Away Team"/>
                    <ComboBox fx:id="awayTeamBox" styleClass="input-field" prefWidth="270"/>

                    <Label text="Home Score"/>
                    <TextField fx:id="homeScoreField" styleClass="input-field"/>

                    <Label text="Away Score"/>
                    <TextField fx:id="awayScoreField" styleClass="input-field"/>

                    <HBox spacing="10">
                        <Button text="Save Match" styleClass="primary-button"/>
                        <Button text="Clear" styleClass="secondary-button"/>
                    </HBox>
                </VBox>

                <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
                    <Label text="Match List" styleClass="page-title"/>

                    <TableView fx:id="matchTable" prefHeight="420">
                        <columns>
                            <TableColumn text="ID" prefWidth="70"/>
                            <TableColumn text="Home Team" prefWidth="170"/>
                            <TableColumn text="Away Team" prefWidth="170"/>
                            <TableColumn text="Score" prefWidth="100"/>
                            <TableColumn text="Status" prefWidth="120"/>
                        </columns>
                    </TableView>
                </VBox>

            </HBox>
        </VBox>
    </center>

</BorderPane>